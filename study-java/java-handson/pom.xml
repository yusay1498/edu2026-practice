<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>java-handson</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>handson01</module>
        <module>handson02</module>
        <module>handson03</module>
        <module>handson04</module>
        <module>handson05</module>
        <module>handson06</module>
        <module>handson07</module>
        <module>handson08</module>
        <module>handson09</module>
        <module>handson10</module>
        <module>handson11</module>
        <module>handson12</module>
        <module>handson13</module>
        <module>handson14</module>
        <module>handson15</module>
        <module>handson16</module>
        <module>handson17</module>
        <module>handson18</module>
        <module>handson19</module>
        <module>handson20</module>
    </modules>

    <properties>
        <java.version>25</java.version>
    </properties>

    <build>
        <plugins>
            <!-- Java コンパイル設定（全モジュール共通） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- 実行可能 jar 作成設定（全モジュール共通） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- ★ Main-Class は子モジュールごとに変わる可能性があるためここでは書かない -->
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
